# ==========================================================
# HUG MONSTER 홈페이지 환경변수 설정 (.env.local 로 복사하여 사용)
# ==========================================================

# 1. Supabase 연결 정보 (필수 - 미설정 시 로컬 파일(data/inquiries.json) 모드로 동작하며 UI에 미연결 상태가 표시됨)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. 관리자(Admin) 페이지 접속 비밀번호 (선택 - 기본값: hugmonster2026)
ADMIN_PASSCODE=hugmonster2026

# 3. Google Analytics 4 측정 ID (선택 - 설정 시 GA4 스크립트 및 문의 전환 이벤트 자동 활성화)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 4. 사이트 기본 URL (SEO / Sitemap / OpenGraph 용)
NEXT_PUBLIC_SITE_URL=https://hugmonster.kr
